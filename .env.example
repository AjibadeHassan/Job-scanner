# GitHub API (for fetching your repos)
# Get from https://github.com/settings/tokens/new (scope: repo)
GITHUB_TOKEN=your_github_token_here
GITHUB_USERNAME=AjibadeHassan

# Telegram Bot API (free, unlimited — https://core.telegram.org/bots/api)
# 1. Message @BotFather on Telegram → /newbot → get bot token
# 2. Start a conversation with your new bot (send /start)
# 3. Get your chat ID: message @userinfobot on Telegram, or visit:
#    https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
#    Look for "chat":{"id":XXXXXXXXX}
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: protect the /api/scan endpoint with a token
# If set, POST /api/scan requires Authorization: Bearer <token>
SCAN_API_TOKEN=
