# GitHub API (for fetching your repos)
GITHUB_TOKEN=your_github_token_here
GITHUB_USERNAME=AjibadeHassan

# Google Gemini API (free — https://aistudio.google.com/app/apikey)
# Create a free API key and paste it here
# Free tier: 15 req/min, 1,500 req/day, 1M tokens/min
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot API (free, unlimited — https://core.telegram.org/bots/api)
# 1. Message @BotFather on Telegram → /newbot → get bot token
# 2. Start a conversation with your new bot (send /start)
# 3. Get your chat ID: message @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: protect the /api/scan endpoint with a token
SCAN_API_TOKEN=
