# GitHub API (for fetching your repos)
GITHUB_TOKEN=your_github_token_here
GITHUB_USERNAME=AjibadeHassan

# Groq API (primary AI — free, fast, reliable)
# Get from https://console.groq.com → API Keys
# Free: 30 req/min, 14,000 req/day
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API (fallback AI — free)
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot API (notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: protect the /api/scan endpoint
SCAN_API_TOKEN=
